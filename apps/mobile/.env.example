# Copy to .env.local for `npm run start -w @overload/mobile`. Never commit .env.local.
# Every value here is public; nothing secret belongs in the app (spec §7).
EXPO_PUBLIC_OVERLOAD_ENV=staging
# The overload-dev anon key (the same public key the staging web app ships).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional, Metro development bundles only: a local `next start` against overload-dev.
# EXPO_PUBLIC_LOCAL_API_ORIGIN=http://localhost:3200
