{
  "name": "overload-training",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @overload/web --",
    "build": "npm run build -w @overload/web --",
    "start": "npm run start -w @overload/web --",
    "lint": "npm run lint --workspaces --if-present --",
    "postlint": "eslint scripts",
    "typecheck": "npm run typecheck --workspaces --if-present --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present --",
    "posttest": "npm run verify:workspaces",
    "verify:workspaces": "node scripts/workspace-boundaries.mjs && node --test scripts/workspace-boundaries.test.mjs",
    "test:integration": "npm run test:integration -w @overload/web --",
    "test:e2e": "npm run test:e2e -w @overload/web --",
    "test:e2e:accounts": "npm run test:e2e:accounts -w @overload/web --",
    "verify:client-bundle": "npm run verify:client-bundle -w @overload/web --",
    "db:seed": "npm run db:seed -w @overload/web --",
    "db:migrate:dev": "npm run db:migrate:dev -w @overload/web --",
    "import:plan": "npm run import:plan -w @overload/web --",
    "ownership:backfill": "npm run ownership:backfill -w @overload/web --",
    "founding-members:grant": "npm run founding-members:grant -w @overload/web --",
    "plan-import:cleanup": "npm run plan-import:cleanup -w @overload/web --",
    "demo:seed": "npm run demo:seed -w @overload/web --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "prettier": "^3.9.9"
  }
}
