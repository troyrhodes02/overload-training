// Overload — base schema (Pitch 1: Foundation).
// Shape only: all eleven approved entities with their referential invariants.
// NO feature behavior, NO stored progression tag / e1RM.
// Multi-User Foundation (Pitch 8): every owned model carries userId → Profile.
// Row-level security (deny-all) is enabled on every table in the migration SQL.

datasource db {
  provider = "postgresql"
  // Prisma 7 moves connection URLs to prisma.config.ts.
  // CLI/migrations use the DIRECT_URL (see prisma.config.ts); the runtime
  // client is constructed with the pooled DATABASE_URL in src/lib/db.ts.
}

generator client {
  provider = "prisma-client-js"
}

/// Split & Mesocycle Builder (spec D1): every mesocycle starts as a draft and
/// becomes active only through explicit activation; at most one is active per
/// account (partial unique index mesocycles_single_active_per_user,
/// 9_account_ownership_2_enforce; was global in migration 3).
enum MesocycleStatus {
  draft
  active
  archived
}

/// The structure a mesocycle started from (spec D40). A label only: presets
/// create named empty sessions and never exercises, sets, reps, or weights.
enum SplitType {
  ppl
  arnold
  bro
  custom
}

enum GoalStatus {
  active
  archived
}

/// Goals (Pitch 6, spec R48): why an archived goal left the active list.
/// `completed` is the one-time completion event; `manual` is the lifter
/// retiring it. An archived goal never returns to active.
enum GoalArchiveReason {
  completed
  manual
}

/// Guided Workout Logging (spec §6): a LoggedSession's completion is an explicit
/// stored state, never inferred from navigation or age.
enum LoggedSessionStatus {
  in_progress
  complete
}

/// Guided Workout Logging (spec §6, Resolved Decisions 31–37): how a missed
/// planned day was reconciled. The effective schedule is derived from the plan
/// plus these dated records; the authored Session template is never mutated.
enum MissedDayOutcome {
  logged_late
  shifted
  skipped
}

/// Canonical Overload muscle-group vocabulary (Library & Gyms Setup, spec D6).
/// ONE vocabulary for imported exercises, custom exercises, the library filter,
/// and (later) Exercise Swap. Mirrors src/lib/exercises/taxonomy.ts; the
/// free-exercise-db mapping is documented in docs/planning/method-note.md.
enum MuscleGroup {
  chest
  back
  lower_back
  traps
  shoulders
  biceps
  triceps
  forearms
  core
  quads
  hamstrings
  glutes
  calves
  adductors
  abductors
  neck
}

/// Canonical Overload equipment vocabulary (spec D8). Which values are
/// gym-variable is decided later, in exactly one function (isGymVariable).
enum Equipment {
  barbell
  ez_bar
  dumbbell
  kettlebell
  cable
  machine
  plate_loaded
  bodyweight
  band
  medicine_ball
  exercise_ball
  foam_roller
  other
}

model Mesocycle {
  id               String          @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId           String          @map("user_id") @db.Uuid
  name             String
  lengthWeeks      Int             @map("length_weeks")
  /// Deload cadence: a planned deload falls on every Nth week (weeks N, 2N, 3N…).
  /// The column keeps its Foundation name (no destructive rename migration).
  deloadEveryWeeks Int             @map("deload_week")
  splitType        SplitType       @map("split_type")
  status           MesocycleStatus @default(draft)
  /// Calendar date (no time, no zone). Week 1 begins on this date (spec D59).
  startDate        DateTime?       @map("start_date") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  sessions             Session[]
  loggedSessions       LoggedSession[]
  missedDayResolutions MissedDayResolution[]
  plannedCardio        PlannedCardio[]
  cardioLogs           CardioLog[]
  profile              Profile               @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([status])
  @@index([userId])
  @@map("mesocycles")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId      String   @map("user_id") @db.Uuid
  mesocycleId String   @map("mesocycle_id") @db.Uuid
  name        String
  /// 1 = Monday … 7 = Sunday; null = not on the schedule (spec D41/D42).
  dayOfWeek   Int?     @map("day_of_week")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mesocycle            Mesocycle             @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  sessionExercises     SessionExercise[]
  loggedSessions       LoggedSession[]
  missedDayResolutions MissedDayResolution[]
  profile              Profile               @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // Zero or one session per weekday (NULLs are distinct: any number unscheduled).
  @@unique([mesocycleId, dayOfWeek])
  @@index([mesocycleId])
  @@index([userId])
  @@map("sessions")
}

model SessionExercise {
  id           String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId       String   @map("user_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  exerciseId   String   @map("exercise_id") @db.Uuid
  position     Int      @default(0)
  plannedSets  Int      @map("planned_sets")
  targetRepMin Int      @map("target_rep_min")
  targetRepMax Int      @map("target_rep_max")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Planned template references an Exercise; Restrict so an in-use exercise can't be hard-deleted.
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  // Logged occurrences that fulfilled this planned slot. SetNull on the logged
  // side so editing the plan later never cascades history away.
  loggedExercises LoggedExercise[]
  profile         Profile          @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // One occurrence of an Exercise per Session (spec D20).
  @@unique([sessionId, exerciseId])
  @@index([sessionId, position])
  @@index([exerciseId])
  @@index([userId])
  @@map("session_exercises")
}

// Library & Gyms Setup: exactly one primary muscle, optional distinct
// secondaries (never the primary), canonical equipment, provenance (sourceId
// for imported rows, isCustom for the lifter's own), and a manual favorite
// flag. The CHECK constraints that enforce these live in the migration SQL.
model Exercise {
  id               String        @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). NULL = shared library row (read-only
  /// to the app); set = custom exercise of that account. Never changes.
  userId           String?       @map("user_id") @db.Uuid
  name             String
  /// Exactly one primary muscle. The column keeps its Foundation name.
  primaryMuscle    MuscleGroup   @map("muscle_group")
  /// Zero or more, distinct, never the primary. Descriptive metadata only.
  secondaryMuscles MuscleGroup[] @default([]) @map("secondary_muscles")
  equipmentType    Equipment     @map("equipment_type")
  /// Storage object path in the exercise-images bucket; always null for custom.
  imageRef         String?       @map("image_ref")
  isCustom         Boolean       @default(false) @map("is_custom")
  /// free-exercise-db record id: the import identity key. Null for custom.
  sourceId         String?       @unique @map("source_id")
  /// DEPRECATED (Multi-User Foundation, spec R12): superseded by ExerciseFavorite.
  /// Not read or written by any code; kept so no column holding data is dropped.
  isFavorite       Boolean       @default(false) @map("is_favorite")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  sessionExercises       SessionExercise[]
  // The exercise actually performed (LoggedExercise.exerciseId).
  loggedExercises        LoggedExercise[]      @relation("PerformedExercise")
  // The exercise originally planned for that occurrence (LoggedExercise.plannedExerciseId).
  plannedLoggedExercises LoggedExercise[]      @relation("PlannedExercise")
  baselines              GymExerciseBaseline[]
  goals                  Goal[]
  profile                Profile?              @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  favorites              ExerciseFavorite[]

  @@index([primaryMuscle])
  @@index([deletedAt])
  @@index([userId])
  @@map("exercises")
}

model Gym {
  id        String    @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId    String    @map("user_id") @db.Uuid
  name      String
  address   String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  baselines       GymExerciseBaseline[]
  loggedExercises LoggedExercise[]
  goals           Goal[]
  profile         Profile               @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([deletedAt])
  @@index([userId])
  @@map("gyms")
}

model GymExerciseBaseline {
  id         String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId     String   @map("user_id") @db.Uuid
  gymId      String   @map("gym_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  weightLbs  Decimal  @map("weight_lbs") @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Restrict)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  profile  Profile  @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // One baseline per (gym, exercise).
  @@unique([gymId, exerciseId])
  @@index([exerciseId])
  @@index([userId])
  @@map("gym_exercise_baselines")
}

model LoggedSession {
  id           String              @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId       String              @map("user_id") @db.Uuid
  mesocycleId  String?             @map("mesocycle_id") @db.Uuid
  sessionId    String?             @map("session_id") @db.Uuid
  performedOn  DateTime            @map("performed_on") @db.Timestamptz
  /// The authored calendar date of the planned occurrence this session fulfills
  /// (Guided Workout Logging, Resolved Decision 2). The idempotency key, so
  /// opening/resuming never creates a second LoggedSession for the same occurrence.
  scheduledFor DateTime            @map("scheduled_for") @db.Date
  /// Explicit completion state; never inferred (Resolved Decision 3).
  status       LoggedSessionStatus @default(in_progress)
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // History is never cascaded away by a plan edit. Restrict on the plan references.
  mesocycle       Mesocycle?       @relation(fields: [mesocycleId], references: [id], onDelete: Restrict)
  session         Session?         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  loggedExercises LoggedExercise[]
  profile         Profile          @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // One LoggedSession per planned occurrence (sessionId, scheduledFor). Postgres
  // treats NULLs as distinct, so this constrains only real session-backed rows.
  @@unique([sessionId, scheduledFor])
  @@index([performedOn])
  @@index([mesocycleId])
  @@index([userId])
  @@map("logged_sessions")
}

model LoggedExercise {
  id                String    @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId            String    @map("user_id") @db.Uuid
  loggedSessionId   String    @map("logged_session_id") @db.Uuid
  /// The exercise actually performed (changes on swap).
  exerciseId        String    @map("exercise_id") @db.Uuid
  gymId             String?   @map("gym_id") @db.Uuid
  position          Int       @default(0)
  /// Plan-context snapshot (Guided Workout Logging, Resolved Decision 8): what was
  /// planned for this occurrence, so later plan edits can't make history
  /// unintelligible. `exerciseId` is performed; `plannedExerciseId` is immutable.
  plannedExerciseId String    @map("planned_exercise_id") @db.Uuid
  sessionExerciseId String?   @map("session_exercise_id") @db.Uuid
  plannedSets       Int       @map("planned_sets")
  targetRepMin      Int       @map("target_rep_min")
  targetRepMax      Int       @map("target_rep_max")
  /// The lifter marked this exercise "Didn't do" (only possible with no sets
  /// logged). A completed workout also stamps it on any exercise left with no
  /// sets. A fact about the day — never a derived or progression value.
  skippedAt         DateTime? @map("skipped_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // The logged chain is Restrict all the way down; history is never cascaded away.
  loggedSession   LoggedSession    @relation(fields: [loggedSessionId], references: [id], onDelete: Restrict)
  exercise        Exercise         @relation("PerformedExercise", fields: [exerciseId], references: [id], onDelete: Restrict)
  plannedExercise Exercise         @relation("PlannedExercise", fields: [plannedExerciseId], references: [id], onDelete: Restrict)
  // SetNull: deleting a SessionExercise (plan edit) must not cascade history away;
  // the snapshot fields above are the durable contract.
  sessionExercise SessionExercise? @relation(fields: [sessionExerciseId], references: [id], onDelete: SetNull)
  gym             Gym?             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  sets            LoggedSet[]
  profile         Profile          @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // No progressionTag column and no e1RM column. Both are computed on read in later pitches.
  @@index([loggedSessionId, position])
  @@index([exerciseId])
  @@index([plannedExerciseId])
  @@index([gymId])
  @@index([userId])
  @@map("logged_exercises")
}

model MissedDayResolution {
  id          String           @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId      String           @map("user_id") @db.Uuid
  mesocycleId String           @map("mesocycle_id") @db.Uuid
  /// The planned Session occurrence that was missed (SetNull if the plan slot is
  /// later removed; the dated record still stands).
  sessionId   String?          @map("session_id") @db.Uuid
  /// The authored calendar date that was missed (DATE, no zone).
  missedOn    DateTime         @map("missed_on") @db.Date
  outcome     MissedDayOutcome
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Restrict)
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  profile   Profile   @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // One resolution per missed planned day. Immutable in Pitch 4.
  @@unique([mesocycleId, missedOn])
  @@index([mesocycleId])
  @@index([userId])
  @@map("missed_day_resolutions")
}

model LoggedSet {
  id               String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId           String   @map("user_id") @db.Uuid
  loggedExerciseId String   @map("logged_exercise_id") @db.Uuid
  setNumber        Int      @map("set_number")
  /// External load. NULL iff the set is pure bodyweight (reps only) — never 0
  /// or a guessed bodyweight. CHECK weight_lbs IS NULL OR > 0 (migration 8);
  /// which exercises may store NULL is decided by requiresExternalWeight().
  weightLbs        Decimal? @map("weight_lbs") @db.Decimal(6, 2)
  reps             Int
  /// Reported reps in reserve (RIR Logging & Autoregulation). NULL = not
  /// recorded — never 0, never inferred or backfilled. 0..4, where 4 means
  /// "4 or more". CHECK rir IS NULL OR rir BETWEEN 0 AND 4 (migration 9f).
  /// Written only by src/lib/logging/logged-sets.ts; never read by e1RM,
  /// baselines, goals, or the weight offer.
  rir              Int?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  loggedExercise LoggedExercise @relation(fields: [loggedExerciseId], references: [id], onDelete: Restrict)
  profile        Profile        @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // A retried set collides here; a deliberate change goes through editLoggedSet (later pitch).
  @@unique([loggedExerciseId, setNumber])
  @@index([userId])
  @@map("logged_sets")
}

/// Goals (Pitch 6): one lifter-authored, undated target for one Exercise.
/// Stores the target, its measurement context, and lifecycle ONLY — progress
/// (target e1RM, best e1RM, percent) is derived on read from LoggedSets.
/// At most one active goal per exercise per account, at any gym: partial unique
/// index goals_one_active_per_exercise_per_user (9_account_ownership_2_enforce;
/// was global in migration 5). Lifecycle consistency and
/// positive targets are CHECK constraints in the same migration.
model Goal {
  id                       String             @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId                   String             @map("user_id") @db.Uuid
  exerciseId               String             @map("exercise_id") @db.Uuid
  /// Measurement gym — set iff the Exercise is gym-variable (machine/cable).
  gymId                    String?            @map("gym_id") @db.Uuid
  targetWeightLbs          Decimal            @map("target_weight_lbs") @db.Decimal(6, 2)
  targetReps               Int                @map("target_reps")
  status                   GoalStatus         @default(active)
  archiveReason            GoalArchiveReason? @map("archive_reason")
  /// When the goal left the active list (completion time when reason = completed).
  archivedAt               DateTime?          @map("archived_at") @db.Timestamptz
  /// The one-time "Goal reached" card was dismissed. Completed goals only.
  completionAcknowledgedAt DateTime?          @map("completion_acknowledged_at") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  gym      Gym?     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  profile  Profile  @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  // No progress / percent / e1RM column: goal progress is computed on read.
  @@index([exerciseId])
  @@index([gymId])
  @@index([status])
  @@index([userId])
  @@map("goals")
}

/// Cardio Logging (Pitch 7): the cardio planned for one weekday of a mesocycle.
/// It belongs to the DAY, never to a Session — a day may have lifting, cardio,
/// both, or neither. Zero or one per weekday (unique below). Type + whole
/// minutes only: no metric, gym, or progression column ever lives here.
/// Written only by src/lib/plan/cardio.ts (and clone-forward in mesocycles.ts).
/// CHECKs (day 1–7, minutes 1–600, trimmed type 1–40) live in migration 6.
model PlannedCardio {
  id          String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId      String   @map("user_id") @db.Uuid
  mesocycleId String   @map("mesocycle_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday. Planned cardio is always on a day.
  dayOfWeek   Int      @map("day_of_week")
  type        String
  durationMin Int      @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Restrict)
  profile   Profile   @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([mesocycleId, dayOfWeek])
  @@index([userId])
  @@map("planned_cardio")
}

/// Cardio Logging (Pitch 7): what was actually done for ONE planned cardio
/// occurrence. Identity is (mesocycleId, scheduledFor) — the authored date of
/// the occurrence — so a retry can never record it twice. There is no FK to
/// PlannedCardio: editing or removing the plan can never touch this record.
/// The planned* columns are an immutable snapshot; type/durationMin are the
/// correctable facts. No tag, trend, e1RM, gym, or metric column ever lives here.
/// Written only by src/lib/cardio/cardio-logs.ts. Never deleted.
model CardioLog {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Owning account (Multi-User Foundation). Required and immutable (DB triggers,
  /// 9_account_ownership_2_enforce); every owned parent it references has the same owner.
  userId             String   @map("user_id") @db.Uuid
  mesocycleId        String   @map("mesocycle_id") @db.Uuid
  /// The authored calendar date of the planned occurrence (DATE, no zone).
  scheduledFor       DateTime @map("scheduled_for") @db.Date
  plannedType        String   @map("planned_type")
  plannedDurationMin Int      @map("planned_duration_min")
  type               String
  durationMin        Int      @map("duration_min")
  performedOn        DateTime @map("performed_on") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Restrict)
  profile   Profile   @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([mesocycleId, scheduledFor])
  @@index([performedOn])
  @@index([userId])
  @@map("cardio_logs")
}

/// The account's appearance preference. System follows the device.
enum Appearance {
  system
  light
  dark

  @@map("appearance")
}

/// Multi-User Foundation (Pitch 8): one row per account, keyed by the Supabase
/// auth user id (the account's userId). The ownership root — every owned row's
/// userId references it (Restrict) — and the home of the account's IANA
/// timezone, the ONLY authority for "today" (src/lib/data/account.ts).
/// Email and password live in Supabase Auth, never here. Names stay nullable
/// until Accounts (Pitch 9) collects them at signup. RLS deny-all (migration 9).
model Profile {
  userId       String        @id @map("user_id") @db.Uuid
  firstName    String?       @map("first_name")
  lastName     String?       @map("last_name")
  /// Unique handle, stored lowercase (so uniqueness ignores case) and
  /// checked by a database CHECK constraint (^[a-z0-9_]{3,20}$). Nullable only
  /// because accounts created before usernames have none; signup requires it.
  username     String?       @unique
  /// IANA zone name (e.g. "America/Chicago"), validated by isValidTimeZone on write.
  timeZone     String        @map("time_zone")
  /// Appearance preference (Personalization & Navigation Polish); the only
  /// authority — the browser's first-paint mirror is a copy.
  appearance   Appearance    @default(system)
  /// Admin Center & Feedback: whether the account may use Overload. Changed
  /// only by the admin suspend/reactivate operations (each audited); enforced
  /// by requireAccount() on every authenticated request.
  status       AccountStatus @default(active)
  /// The last calendar day (in the account's own timezone) it made an
  /// authenticated request while active. Date only; written at most once a
  /// day; NULL until its first request after this shipped.
  lastActiveOn DateTime?     @map("last_active_on") @db.Date
  /// Public Accounts: when this account proved it owns its email (app-level,
  /// because createConfirmedUser sets Supabase email_confirm=true at signup so
  /// Supabase's own email_confirmed_at is always set and useless as our signal).
  /// NULL = unverified. Gates NOTHING in this build; recorded for a future
  /// first-checkout gate (Billing) to read. Set only by the verification flow,
  /// scoped to the acting account; never cleared in this pitch.
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  mesocycles           Mesocycle[]
  sessions             Session[]
  sessionExercises     SessionExercise[]
  exercises            Exercise[]
  exerciseFavorites    ExerciseFavorite[]
  gyms                 Gym[]
  gymExerciseBaselines GymExerciseBaseline[]
  loggedSessions       LoggedSession[]
  loggedExercises      LoggedExercise[]
  loggedSets           LoggedSet[]
  missedDayResolutions MissedDayResolution[]
  goals                Goal[]
  plannedCardio        PlannedCardio[]
  cardioLogs           CardioLog[]
  tourProgress         TourProgress?
  releaseSeen          ReleaseSeen?
  feedback             Feedback[]
  feedbackAttachments  FeedbackAttachment[]

  @@map("profiles")
}

/// Latest finished-or-skipped outcome of the onboarding tour (Onboarding Tour).
enum TourOutcome {
  completed
  skipped

  @@map("tour_outcome")
}

/// Per-account onboarding tour progress (Onboarding Tour, spec §8; the
/// architecture's TourProgress). Created DUE when a new account's profile is
/// established at signup; the tour opens by itself only while the row is due
/// (offeredAt and outcome both NULL), so it does so once, ever. Accounts that
/// predate the tour have no row and are never auto-toured (a replay creates
/// one). outcome/outcomeAt record the latest finished or skipped run, replays
/// included. Never deleted except by account deletion.
/// RLS deny-all; user_id immutable (trigger, 9d).
model TourProgress {
  /// Owning account, also the key: one row per account.
  userId    String       @id @map("user_id") @db.Uuid
  /// When the automatically started tour first appeared (the offer is spent).
  offeredAt DateTime?    @map("offered_at") @db.Timestamptz
  /// NULL until a run is finished or skipped. A CHECK keeps outcome and
  /// outcomeAt both set or both NULL.
  outcome   TourOutcome?
  outcomeAt DateTime?    @map("outcome_at") @db.Timestamptz
  /// When the row was created (signup, or a first replay).
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@map("tour_progress")
}

/// Per-account record of the release notes shown (What's New, spec §8; the
/// architecture's ReleaseSeen). One row per account: the newest release-note
/// entry the account has been shown, or started at when it signed up. Entries
/// themselves are repository content (src/lib/release-notes/entries.ts), never
/// rows. The seen point only moves forward. No row = the account predates What's
/// New and has been shown nothing. Never deleted except by account deletion.
/// RLS deny-all; user_id immutable (trigger, 9e).
model ReleaseSeen {
  /// Owning account, also the key: one row per account.
  userId            String   @id @map("user_id") @db.Uuid
  /// A catalog entry id (kebab-case slug, CHECK in 9e). Not a foreign key:
  /// the catalog lives in the repository.
  lastSeenReleaseId String   @map("last_seen_release_id")
  /// When the seen point last moved (signup, or a dialog shown).
  lastSeenAt        DateTime @map("last_seen_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@map("release_seen")
}

/// Multi-User Foundation (Pitch 8, spec R12): account X starred exercise E (a
/// library exercise or X's own custom one). Replaces the shared
/// Exercise.isFavorite flag, which lets one account change another's library.
/// RLS deny-all (migration 9).
model ExerciseFavorite {
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile  Profile  @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([userId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_favorites")
}

/// Admin Center & Feedback (spec section 8): may this account use Overload.
enum AccountStatus {
  active
  suspended
}

/// Admin Center & Feedback: what a feedback message is about (spec R5).
enum FeedbackCategory {
  bug
  idea
  question
  other
}

/// A message a lifter chose to send to the owner (Admin Center & Feedback).
/// Owned by the sender; deleted with the account by the deletion module.
/// Nothing is attached to it: no route, device, or training context.
model Feedback {
  id        String           @id @default(uuid()) @db.Uuid
  /// Owning account (the sender).
  userId    String           @map("user_id") @db.Uuid
  category  FeedbackCategory
  /// Trimmed, 1-2000 characters (CHECK). Plain text; never rendered as HTML.
  message   String
  /// NULL = open. Set by the admin "Mark handled", cleared by "Reopen".
  handledAt DateTime?        @map("handled_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  profile     Profile              @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  attachments FeedbackAttachment[]

  @@index([userId, createdAt])
  @@index([handledAt, createdAt])
  @@map("feedback")
}

/// A screenshot a lifter attached to a Feedback message (Admin Center &
/// Feedback). Owned by the sender. The image bytes live in the private
/// feedback-screenshots Storage bucket (service-role only, like every app
/// table); this row holds only the object path and metadata. Deleted with the
/// account, and before its Feedback parent, by the deletion module.
model FeedbackAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  /// Owning account (the sender), stamped by the account-scoped client.
  userId     String   @map("user_id") @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  /// Object path within the feedback-screenshots bucket (owner-prefixed).
  objectPath String   @map("object_path")
  /// image/png, image/jpeg, or image/webp (CHECK).
  contentType String  @map("content_type")
  /// Stored byte size, 1..3,000,000 (CHECK).
  sizeBytes  Int      @map("size_bytes")
  /// Display order within the message, 0..3 (CHECK).
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profile  Profile  @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([feedbackId, position])
  @@map("feedback_attachments")
}

/// What an admin did (Admin Center & Feedback spec section 8). Account
/// deletion is not an admin action in this build (spec R7).
enum AdminAuditAction {
  account_suspend
  account_reactivate
  feedback_handled
  feedback_reopened
  feedback_recategorized
  account_reset_email_sent // Public Accounts: owner sent a password-reset email
}

/// Append-only record of an admin action: who, what, which account, when
/// (Architecture: AdminAuditEntry; spec R11). ADMIN-ONLY: it has no owner
/// column, so the account-scoped client refuses it, and it has no foreign
/// keys, so it never blocks account deletion and outlives it. A database
/// trigger rejects UPDATE and DELETE. Written only by recordAudit() inside the
/// transaction of the mutation it records.
model AdminAuditEntry {
  id           String           @id @default(uuid()) @db.Uuid
  /// The admin's auth user id (on the allowlist when the action ran).
  actorUserId  String           @map("actor_user_id") @db.Uuid
  /// What was done ("kind", not "action": that word is reserved by the
  /// no-stored-recommendation guard).
  kind         AdminAuditAction
  /// The account the action affected.
  targetUserId String           @map("target_user_id") @db.Uuid
  /// The feedback row, for feedback actions.
  feedbackId   String?          @map("feedback_id") @db.Uuid
  /// Only for kind feedback_recategorized: {"from": category, "to": category} (CHECK).
  detail       Json?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([feedbackId])
  @@map("admin_audit_entries")
}

/// Public Accounts: a DB-backed, server-enforced rate limiter for the two
/// PRE-authentication endpoints (signup, forgot-password), built without a
/// cache or queue (CLAUDE.md infra non-goal). One row per (hashed key, action,
/// fixed time window). It is intentionally UN-OWNED: it throttles attempts for
/// which no account or session exists yet, so it cannot be account-scoped.
/// It holds NO personal data — only a SHA-256 hash of the throttle key (the
/// email for forgot-password, a coarse request fingerprint for signup) and the
/// window bucket — and it is reachable ONLY through src/lib/accounts/throttle.ts
/// (a dedicated raw-allowed module, added in PA2), never through the
/// account-scoped client (scopeArgs refuses any model without a userId). RLS
/// deny-all; no FK, so it never blocks account deletion and outlives it.
model AuthThrottle {
  /// SHA-256 hex of `${action}:${normalizedKey}` — never the raw email/IP.
  keyHash     String             @map("key_hash")
  /// Which endpoint this count is for.
  action      AuthThrottleAction
  /// The fixed window start (truncated to WINDOW_SECONDS), as epoch seconds.
  windowStart Int                @map("window_start")
  /// Attempts seen in this (key, action, window).
  count       Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@id([keyHash, action, windowStart])
  @@index([createdAt]) // for a best-effort periodic prune, if ever added
  @@map("auth_throttle")
}

/// Which pre-auth endpoint an AuthThrottle row counts (Public Accounts).
enum AuthThrottleAction {
  signup
  password_reset_request

  @@map("auth_throttle_action")
}
